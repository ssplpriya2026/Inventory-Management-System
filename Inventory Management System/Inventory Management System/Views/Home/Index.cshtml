@{
    ViewData["Title"] = "Home Page/DashBoard";
}

<h2>DashBoard</h2>
<div class="row mt-4">
    <div class="col-md-4">
        <div class="card mb-3 shadow-sm">
            <div class="card-body text-center">
                <h5 class="text-muted">Total Products</h5>
                <h2>@Model.TotalProducts</h2>
            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card mb-3 shadow-sm">
            <div class="card-body text-center">
                <h5 class="text-muted">Total Stock Value</h5>
                <h2>@Model.TotalStockValue</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3 shadow-sm">
            <div class="card-body text-center">
                <h5 class="text-muted">Low Stock Products</h5>
                <h2>@Model.LowStockCount</h2>
            </div>
        </div>
    </div>
</div>


