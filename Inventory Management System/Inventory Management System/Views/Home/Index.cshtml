@{
    ViewData["Title"] = "Home Page/DashBoard";
}

<h2>DashBoard</h2>
<em class="text-muted">Welcome back. Here's a snapshot of your inventory as of @DateTime.Now.ToString("dddd, MMMM d, yyyy").</em>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card mb-3 shadow-sm" style="border: none; border-left: 4px solid #0d6efd; border-radius: 6px;">
            <div class="card-body">
                <h5 class="text-muted mb-1">Total Products</h5>
                <h2 style="font-weight:600;">@Model.TotalProducts</h2>
            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card mb-3 shadow-sm" style="border: none; border-left: 4px solid #0d6efd; border-radius: 6px;">
            <div class="card-body">
                <h5 class="text-muted mb-1">Total Stock Value</h5>
                <h2 style="font-weight:600;">@Model.TotalStockValue.ToString("C")</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3 shadow-sm" style="border: none; border-left: 4px solid #0d6efd; border-radius: 6px;">
            <div class="card-body">
                <h5 class="text-muted mb-1">Low Stock Products</h5>
                <h2 style="font-weight:600;">@Model.LowStockCount</h2>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Recent Stock Movements</h4>

@if (Model.RecentTransaction.Count == 0)
{
    <p class="text-muted">No stock movements recorded.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Type</th>
                <th>Quantity</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Model.RecentTransaction)
            {
                <tr>
                    <td>@transaction.ProductName</td>
                    <td>
                        @if (transaction.Type == "IN")
                        {
                            <span class="badge bg-success" >IN</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">OUT</span>
                        }
                    </td>
                    <td>@transaction.Quantity</td>
                    <td>@transaction.Date.ToString("MMM d, yyyy h:mm tt")</td>  
                </tr>
            }
        </tbody>
    </table>
}

